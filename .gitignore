# ============================================================
# MCLRP-MFMR
# Git ignore rules for the public reproducibility repository
# ============================================================


# ------------------------------------------------------------
# 1. Python cache / compiled files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/


# ------------------------------------------------------------
# 2. Virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
conda-env/


# ------------------------------------------------------------
# 3. IDE / editor files
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# ------------------------------------------------------------
# 4. Build / packaging artifacts
# ------------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/


# ------------------------------------------------------------
# 5. Jupyter temporary files
# ------------------------------------------------------------
.ipynb_checkpoints/


# ------------------------------------------------------------
# 6. Logs and temporary files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak

logs/
tmp/
temp/


# ------------------------------------------------------------
# 7. Experimental results
#
# Complete archived results are distributed separately through
# a GitHub Release / Zenodo archive rather than tracked in Git.
# ------------------------------------------------------------
results/
outputs/
runs/


# ------------------------------------------------------------
# 8. Upstream / local pharmacogenomic datasets
#
# Dataset manifests and documentation under data/ ARE tracked.
# Actual upstream or locally reconstructed matrices ARE NOT.
# ------------------------------------------------------------
data/raw/
data/processed/
data/local/
data/downloads/
data/cache/

# Common large biological data formats under data/
data/**/*.xlsx
data/**/*.xls
data/**/*.csv.gz
data/**/*.tsv.gz
data/**/*.h5
data/**/*.hdf5
data/**/*.parquet
data/**/*.pkl
data/**/*.pickle

# Specific legacy/local benchmark files
data/**/CCLE_X.npz
data/**/MMnormal.npz
data/**/CGP_X.npz
data/**/Mutation.xlsx
data/**/*Mutation*.csv


# ------------------------------------------------------------
# 9. Local paths / secrets / machine-specific configuration
# ------------------------------------------------------------
.env
.env.*
!.env.example

local_config.*
private_config.*
secrets.*
credentials.*


# ------------------------------------------------------------
# IMPORTANT
#
# Do NOT globally ignore *.npz.
# The repository intentionally tracks frozen split files under:
#
#   splits/primary_10x10/
#
# These files are necessary for exact evaluation reproduction.
# ------------------------------------------------------------
