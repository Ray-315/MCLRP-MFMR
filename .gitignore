# ============================================================
# MCLRP-MFMR
# Git ignore rules for the public reproducibility repository
# ============================================================

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
conda-env/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Jupyter temporary files
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
logs/
tmp/
temp/

# Experimental results
# Complete archived results are distributed separately through
# a GitHub Release / Zenodo archive rather than tracked in Git.
results/
outputs/
runs/

# Upstream / local pharmacogenomic datasets
# Dataset manifests and documentation under data/ ARE tracked.
# Actual upstream or locally reconstructed matrices ARE NOT.
data/raw/
data/processed/
data/local/
data/downloads/
data/cache/

# Common large biological data formats under data/
data/**/*.xlsx
data/**/*.xls
data/**/*.csv.gz
data/**/*.tsv.gz
data/**/*.h5
data/**/*.hdf5
data/**/*.parquet
data/**/*.pkl
data/**/*.pickle

# Specific legacy/local benchmark files
data/**/CCLE_X.npz
data/**/MMnormal.npz
data/**/CGP_X.npz
data/**/Mutation.xlsx
data/**/*Mutation*.csv

# Local paths / secrets / machine-specific configuration
.env
.env.*
!.env.example
local_config.*
private_config.*
secrets.*
credentials.*

# IMPORTANT:
# Do NOT globally ignore *.npz.
# Frozen split files under splits/primary_10x10/ are intentionally tracked.
